FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_DB=ops_flow
POSTGRES_USER=ops_flow
POSTGRES_PASSWORD=ops_flow_local
AUTH_JWT_KEY_DIR=./secrets
# For direct backend runs, export absolute file: URLs for both PEM files.
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_PRIVATE_KEY=
# false only for local HTTP; use true with HTTPS in shared deployments.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Enable once for a new database, then disable and remove the password.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
